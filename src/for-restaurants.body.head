  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://re-charge.co.za/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Restaurants",
          "item": "https://re-charge.co.za/for-restaurants"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can it take bookings properly?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes: it offers times from your booking rules and passes anything unusual to a person. If you use Dineplan, ResDiary or a paper diary, it works alongside it: where it can’t see your bookings, it holds the request and a person confirms."
          }
        },
        {
          "@type": "Question",
          "name": "Does it reply by itself, even mid-service?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only where you choose. It starts with drafts on your real messages so you can check it. Then the safe ones (hours, parking, the menu, a normal table inside your booking rules) can go out by themselves, day or night. Functions, big tables and complaints always wait for a person."
          }
        },
        {
          "@type": "Question",
          "name": "What if it gets a booking wrong?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It never confirms a table it can’t see as free. Anything it isn’t sure of waits for a person."
          }
        },
        {
          "@type": "Question",
          "name": "I have two branches.",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "One assistant can handle both and send each booking to the right branch. The quote covers both."
          }
        },
        {
          "@type": "Question",
          "name": "Do I keep my WhatsApp number?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. It works on your existing WhatsApp Business number, and staff can still read and reply on the phone."
          }
        },
        {
          "@type": "Question",
          "name": "Does it charge commission?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. It’s a fixed price, not a cut of your orders or bookings."
          }
        },
        {
          "@type": "Question",
          "name": "Who will we deal with?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A small studio: the person on your free call builds it and answers your messages, with no call centre or hand-offs. It’s documented and runs in accounts you own, so any developer can pick it up."
          }
        }
      ]
    }
  ]
}
  </script>
