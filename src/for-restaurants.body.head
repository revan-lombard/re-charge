          "@type": "Question",
          "name": "Can it take bookings properly?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes: it offers times from your booking rules and passes anything unusual to a person. If you already use a booking system, we work alongside it."
          }
        },
        {
          "@type": "Question",
          "name": "Does it charge commission?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. It’s a fixed price, not a cut of your orders or bookings."
          }
        },
        {
          "@type": "Question",
          "name": "Do I still need a website?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not to start. A restaurant site with your menu and WhatsApp ordering is an add-on from R12,500."
          }
