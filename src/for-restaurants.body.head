      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can I update the menu and specials myself?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Price and specials changes are included on the Hosting & Care plan, or we set it up so you can edit the menu from your phone."
          }
        },
        {
          "@type": "Question",
          "name": "Do you charge commission on orders?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. WhatsApp ordering has no per-order fees. Online payments go through Yoco at their normal card rate — nothing to us."
          }
        },
        {
          "@type": "Question",
          "name": "Can it show today's specials?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes — a specials block at the top of the menu that you can change in a minute."
          }
        }
      ]
    }
