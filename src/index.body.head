<!DOCTYPE html>
<html lang="en-ZA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Re-Charge — You have the problem. We build the solution.</title>
  <meta name="description" content="Re-Charge builds websites, dashboards, automation, AI integrations and custom software for South African businesses and individuals. Projects from R1,000, start with a R500 deposit. You explain the problem; we build the solution." />
  <link rel="canonical" href="https://re-charge.co.za/" />
  <meta name="theme-color" content="#0a0d13" />

  <meta property="og:url" content="https://re-charge.co.za/" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Re-Charge" />
  <meta property="og:title" content="Re-Charge — You have the problem. We build the solution." />
  <meta property="og:description" content="Websites, dashboards, automation, AI and custom software for South African businesses. Projects from R1,000, start with a R500 deposit." />
  <meta property="og:image" content="https://re-charge.co.za/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="en_ZA" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Re-Charge — You have the problem. We build the solution." />
  <meta name="twitter:description" content="Websites, dashboards, automation, AI and custom software for South African businesses and individuals." />
  <meta name="twitter:image" content="https://re-charge.co.za/og-image.png" />

  <link rel="icon" type="image/svg+xml" href="favicon.svg?v=5" />
  <link rel="icon" type="image/png" sizes="32x32" href="assets/favicon-32.png?v=5" />
  <link rel="apple-touch-icon" href="assets/apple-touch-icon.png?v=5" />
  <link rel="manifest" href="site.webmanifest" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" media="print" onload="this.media=&#39;all&#39;" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" /></noscript>
  <link rel="stylesheet" href="styles.css" />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ProfessionalService",
        "@id": "https://re-charge.co.za/#business",
        "name": "Re-Charge",
        "url": "https://re-charge.co.za/",
        "logo": "https://re-charge.co.za/assets/logo-mark.png",
        "image": "https://re-charge.co.za/og-image.png",
        "slogan": "You have the problem. We build the solution.",
        "description": "Re-Charge is a South African digital solutions studio building websites, dashboards, automation, AI integrations and custom software for businesses and individuals. Projects from R1,000.",
        "areaServed": { "@type": "Country", "name": "South Africa" },
        "priceRange": "R500+",
        "currenciesAccepted": "ZAR",
        "email": "enquiry.re.charge@gmail.com",
        "telephone": "+27722375833",
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "sales",
          "email": "enquiry.re.charge@gmail.com",
          "telephone": "+27722375833",
          "areaServed": "ZA",
          "availableLanguage": "English"
        },
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Services",
          "itemListElement": [
            { "@type": "Offer", "url": "https://re-charge.co.za/services.html#websites", "itemOffered": { "@type": "Service", "name": "Websites", "description": "Fast, professional websites for businesses, services, products and individuals." }, "priceSpecification": { "@type": "PriceSpecification", "minPrice": 1000, "priceCurrency": "ZAR" } },
            { "@type": "Offer", "url": "https://re-charge.co.za/services.html#dashboards", "itemOffered": { "@type": "Service", "name": "Dashboards", "description": "Turn spreadsheets and business data into dashboards you can understand." }, "priceSpecification": { "@type": "PriceSpecification", "minPrice": 2000, "priceCurrency": "ZAR" } },
            { "@type": "Offer", "url": "https://re-charge.co.za/services.html#automation", "itemOffered": { "@type": "Service", "name": "Automation", "description": "Remove repetitive manual work and admin." }, "priceSpecification": { "@type": "PriceSpecification", "minPrice": 2000, "priceCurrency": "ZAR" } },
            { "@type": "Offer", "url": "https://re-charge.co.za/services.html#ai", "itemOffered": { "@type": "Service", "name": "AI Integrations", "description": "Practical AI added to a real business process." }, "priceSpecification": { "@type": "PriceSpecification", "minPrice": 3500, "priceCurrency": "ZAR" } },
            { "@type": "Offer", "url": "https://re-charge.co.za/services.html#software", "itemOffered": { "@type": "Service", "name": "Custom Software", "description": "Calculators, booking systems, trackers, portals and custom tools." }, "priceSpecification": { "@type": "PriceSpecification", "minPrice": 4500, "priceCurrency": "ZAR" } }
          ]
        }
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          { "@type": "Question", "name": "How much does a project cost?", "acceptedAnswer": { "@type": "Answer", "text": "Quick builds start from R500, a quick website is R1,000, a business website R1,500, and custom websites from R2,500. Dashboards and automation start from R2,000, AI integrations from R3,500 and custom tools from R4,500. You see an indicative estimate before you pay anything; the final fixed quote is confirmed after we review your project." } },
          { "@type": "Question", "name": "What is the R500 deposit?", "acceptedAnswer": { "@type": "Answer", "text": "R500 starts the project. It's credited toward your final project price. We review your requirements and confirm the final scope, price and timeline before development begins. If we can't take the project on, the deposit is refunded." } },
          { "@type": "Question", "name": "What if I don't know what I need?", "acceptedAnswer": { "@type": "Answer", "text": "That's completely fine. Tell us what you're currently doing, what's frustrating you, or what you'd like to improve, and we'll work out what could be built to solve it. You don't need to know any technical terms." } },
          { "@type": "Question", "name": "How does hosting work?", "acceptedAnswer": { "@type": "Answer", "text": "Hosting is separate and annual: Hosting from R400/year, Hosting & Care R600/year (small content updates and maintenance included), and Business Care R1,200/year. You remain the owner of your domain; we handle the technical side." } },
          { "@type": "Question", "name": "Do you use templates?", "acceptedAnswer": { "@type": "Answer", "text": "We build around what your business actually needs, using reusable components and modern development methods so we can deliver quickly and keep prices low. Surprisingly good software, surprisingly quickly." } }
        ]
      }
    ]
  }
  </script>
</head>
<body>
