  <meta name="twitter:image" content="https://re-charge.co.za/og-image.png?v=2" />

  <link rel="icon" type="image/png" sizes="32x32" href="assets/favicon-32.png?v=6" />
  <link rel="apple-touch-icon" href="assets/apple-touch-icon.png?v=6" />
  <link rel="manifest" href="site.webmanifest" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" media="print" onload="this.media=&#39;all&#39;" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" /></noscript>
  <link rel="stylesheet" href="styles.css" />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ProfessionalService",
        "@id": "https://re-charge.co.za/#business",
        "name": "Re-Charge",
        "url": "https://re-charge.co.za/",
        "logo": "https://re-charge.co.za/assets/logo-mark.png",
        "image": "https://re-charge.co.za/og-image.png?v=2",
        "slogan": "Tell us the problem. We'll build the solution.",
        "description": "Re-Charge is a South African digital solutions studio building websites, dashboards, automation, AI integrations and custom software for businesses and individuals. Projects from R1,000.",
        "areaServed": { "@type": "Country", "name": "South Africa" },
        "priceRange": "R500+",
        "currenciesAccepted": "ZAR",
        "telephone": "+27722375833",
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "sales",
          "telephone": "+27722375833",
          "areaServed": "ZA",
          "availableLanguage": "English"
        },
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Services",
          "itemListElement": [
            { "@type": "Offer", "url": "https://re-charge.co.za/services#websites", "itemOffered": { "@type": "Service", "name": "Websites", "description": "Fast, professional websites for businesses, services, products and individuals." }, "priceSpecification": { "@type": "PriceSpecification", "minPrice": 1000, "priceCurrency": "ZAR" } },
            { "@type": "Offer", "url": "https://re-charge.co.za/services#dashboards", "itemOffered": { "@type": "Service", "name": "Dashboards", "description": "Turn spreadsheets and business data into dashboards you can understand." }, "priceSpecification": { "@type": "PriceSpecification", "minPrice": 2000, "priceCurrency": "ZAR" } },
            { "@type": "Offer", "url": "https://re-charge.co.za/services#automation", "itemOffered": { "@type": "Service", "name": "Automation", "description": "Remove repetitive manual work and admin." }, "priceSpecification": { "@type": "PriceSpecification", "minPrice": 2000, "priceCurrency": "ZAR" } },
            { "@type": "Offer", "url": "https://re-charge.co.za/services#ai", "itemOffered": { "@type": "Service", "name": "AI Integrations", "description": "Practical AI added to a real business process." }, "priceSpecification": { "@type": "PriceSpecification", "minPrice": 3500, "priceCurrency": "ZAR" } },
            { "@type": "Offer", "url": "https://re-charge.co.za/services#software", "itemOffered": { "@type": "Service", "name": "Custom Software", "description": "Calculators, booking systems, trackers, portals and custom tools." }, "priceSpecification": { "@type": "PriceSpecification", "minPrice": 4500, "priceCurrency": "ZAR" } }
          ]
        }
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          { "@type": "Question", "name": "How much does a project cost?", "acceptedAnswer": { "@type": "Answer", "text": "Quick builds and one-page websites start from R1,000, a business website from R2,000, and custom websites from R4,500. Dashboards and automation start from R2,000, AI integrations from R3,500 and custom tools from R4,500. You see an indicative estimate before you pay anything; the final fixed quote is confirmed after we review your project." } },
          { "@type": "Question", "name": "What is the R500 deposit?", "acceptedAnswer": { "@type": "Answer", "text": "R500 starts the review and reserves your slot. We confirm the final scope, price and timeline first, and the deposit is fully refundable until you approve that quote. Approve it and the R500 comes off your project price; don't go ahead, for any reason, and it's refunded." } },
          { "@type": "Question", "name": "What if I don't know what I need?", "acceptedAnswer": { "@type": "Answer", "text": "That's completely fine. Tell us what you're currently doing, what's frustrating you, or what you'd like to improve, and we'll work out what could be built to solve it. You don't need to know any technical terms." } },
          { "@type": "Question", "name": "How does hosting work?", "acceptedAnswer": { "@type": "Answer", "text": "A website is only live while it's hosted, so some hosting is required, separate from the one-off build. Ongoing sites take an annual plan: Hosting from R400/year, Hosting & Care R600/year (small updates included) or Business Care R2,400/year. Event or once-off sites are hosted only for the period you need. You own your domain and can host elsewhere if you prefer." } },
          { "@type": "Question", "name": "Do you use templates?", "acceptedAnswer": { "@type": "Answer", "text": "We build around what your business actually needs, using reusable components and modern development methods so we can deliver quickly and keep prices low. Surprisingly good software, surprisingly quickly." } }
        ]
      }
    ]
  }
  </script>
</head>
