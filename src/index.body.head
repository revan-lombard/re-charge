  <link rel="stylesheet" href="styles.css" />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ProfessionalService",
        "@id": "https://re-charge.co.za/#business",
        "name": "Re-Charge",
        "url": "https://re-charge.co.za/",
        "logo": "https://re-charge.co.za/assets/logo-mark.png",
        "image": "https://re-charge.co.za/og-image.png?v=4",
        "slogan": "Tell us the problem. We'll build the solution.",
        "description": "Re-Charge is an independent South African developer building AI assistants, automation, dashboards, websites and custom software for businesses and individuals. Projects from R1,000.",
        "areaServed": { "@type": "Country", "name": "South Africa" },
        "priceRange": "R1,000+",
        "currenciesAccepted": "ZAR",
        "telephone": "+27722375833",
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "sales",
          "telephone": "+27722375833",
          "areaServed": "ZA",
          "availableLanguage": "English"
        },
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Services",
          "itemListElement": [
{ "@type": "Offer", "url": "https://re-charge.co.za/services#ai", "itemOffered": { "@type": "Service", "name": "AI Integrations", "description": "Practical AI added to a real business process." }, "priceSpecification": { "@type": "PriceSpecification", "minPrice": 3500, "priceCurrency": "ZAR" } },
{ "@type": "Offer", "url": "https://re-charge.co.za/services#automation", "itemOffered": { "@type": "Service", "name": "Automation", "description": "Remove repetitive manual work and admin." }, "priceSpecification": { "@type": "PriceSpecification", "minPrice": 2000, "priceCurrency": "ZAR" } },
{ "@type": "Offer", "url": "https://re-charge.co.za/services#dashboards", "itemOffered": { "@type": "Service", "name": "Dashboards", "description": "Turn spreadsheets and business data into dashboards you can understand." }, "priceSpecification": { "@type": "PriceSpecification", "minPrice": 2000, "priceCurrency": "ZAR" } },
{ "@type": "Offer", "url": "https://re-charge.co.za/services#websites", "itemOffered": { "@type": "Service", "name": "Websites", "description": "Fast, professional websites for businesses, services, products and individuals." }, "priceSpecification": { "@type": "PriceSpecification", "minPrice": 1000, "priceCurrency": "ZAR" } },
{ "@type": "Offer", "url": "https://re-charge.co.za/services#software", "itemOffered": { "@type": "Service", "name": "Custom Software", "description": "Calculators, booking systems, trackers, portals and custom tools." }, "priceSpecification": { "@type": "PriceSpecification", "minPrice": 4500, "priceCurrency": "ZAR" } }
        ]
        }
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          { "@type": "Question", "name": "How much does a project cost?", "acceptedAnswer": { "@type": "Answer", "text": "One-page websites start from R1,000, a business website from R2,000, and custom websites from R4,500. Dashboards and automation start from R7,500, AI assistants from R5,900 and custom tools from R17,500. You see an indicative estimate before you pay anything; the final fixed quote is confirmed after we review your project." } },
          { "@type": "Question", "name": "How quickly will you reply, and how quickly is my site live?", "acceptedAnswer": { "@type": "Answer", "text": "We reply within an hour, every day from 7am to 9pm (messages after 9pm get a reply by 8am). Once you approve the design and we have your logo, photos and prices, your website is live within 7 days, or your first month of Care is free." } },
          { "@type": "Question", "name": "When do I pay the deposit?", "acceptedAnswer": { "@type": "Answer", "text": "Only once you've seen and accepted your fixed quote. Tell us what you need (free), we send you a fixed quote online with the scope, price and timeline, and if you're happy you accept it and pay the deposit by card. It comes off your project price, and the balance is due on completion. Don't like the quote? Don't accept it — you haven't paid anything." } },
          { "@type": "Question", "name": "What if I don't know what I need?", "acceptedAnswer": { "@type": "Answer", "text": "That's completely fine. Tell us what you're currently doing, what's frustrating you, or what you'd like to improve, and we'll work out what could be built to solve it. You don't need to know any technical terms." } },
          { "@type": "Question", "name": "How does hosting work?", "acceptedAnswer": { "@type": "Answer", "text": "A website is only live while it's hosted, so some hosting is required, separate from the one-off build. Ongoing sites take a plan, paid monthly or yearly (yearly is 2 months free): Hosting R50/month or R500/year, Care R150/month or R1,500/year (small changes, your Google Business Profile kept up to date and a monthly report), or AI Care R550/month or R5,500/year. New websites include the first year of Care. Event or once-off sites are hosted only for the period you need. You own your domain and can host elsewhere if you prefer." } },
          { "@type": "Question", "name": "Do you use templates?", "acceptedAnswer": { "@type": "Answer", "text": "We build around what your business actually needs, using reusable components and modern development methods so we can deliver quickly and keep prices low. Surprisingly good software, surprisingly quickly." } }
        ]
      }
    ]
  }
  </script>
