    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much does a project cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Websites start from R1,000, dashboards and automations from R2,000, AI solutions from R3,500 and custom software from R4,500. These are starting prices; you get a fixed proposal with the exact scope and price before development."
          }
        },
        {
          "@type": "Question",
          "name": "I don't know what I need. Can you help?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Tell us what's frustrating you or what takes too long, in your own words. We'll suggest a practical solution, which isn't always AI."
          }
        },
        {
          "@type": "Question",
          "name": "Are there ongoing costs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sometimes: hosting from R50 a month, third-party subscriptions and AI usage at cost, and support if you want it. They're listed in your proposal before you agree to anything."
