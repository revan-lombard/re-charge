        "https://www.linkedin.com/company/re-charge-ai"
      ],
      "description": "Re-Charge designs and implements AI systems that automate repetitive business processes, connect existing software and give teams better access to the information they already have — measured before and after, then run and improved monthly.",
      "areaServed": {
        "@type": "Country",
        "name": "South Africa"
      },
      "priceRange": "R7,500+",
      "currenciesAccepted": "ZAR",
      "telephone": "+27722375833",
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "sales",
        "telephone": "+27722375833",
        "areaServed": "ZA",
        "availableLanguage": "English"
      },
      "knowsAbout": [
        "AI process automation",
        "Enquiry handling automation",
        "Document knowledge bases",
        "Invoice and document capture",
        "Workflow automation",
        "Software integration"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "url": "https://re-charge.co.za/pricing#implementation",
            "itemOffered": {
              "@type": "Service",
              "name": "Discovery & opportunity map",
              "description": "Map the processes, measure the baseline and score every AI opportunity. Credited against implementation within 60 days."
            },
            "price": "7500",
            "priceCurrency": "ZAR"
          },
          {
            "@type": "Offer",
            "url": "https://re-charge.co.za/pricing#implementation",
            "itemOffered": {
              "@type": "Service",
              "name": "Proof of concept",
              "description": "The smallest useful version of an AI system, built on real work and measured before and after."
            },
            "priceSpecification": {
              "@type": "PriceSpecification",
              "minPrice": 18500,
              "priceCurrency": "ZAR"
            }
          },
          {
            "@type": "Offer",
            "url": "https://re-charge.co.za/pricing#implementation",
            "itemOffered": {
              "@type": "Service",
              "name": "Production implementation",
              "description": "An AI system integrated with your software, documented, and your team trained."
            },
            "priceSpecification": {
              "@type": "PriceSpecification",
              "minPrice": 45000,
              "priceCurrency": "ZAR"
            }
          },
          {
            "@type": "Offer",
            "url": "https://re-charge.co.za/pricing#operations",
            "itemOffered": {
              "@type": "Service",
              "name": "AI operations",
              "description": "Monitoring, model and API costs, maintenance, security updates, evaluation, support to an SLA, improvements and a monthly ROI report."
            },
            "priceSpecification": {
              "@type": "UnitPriceSpecification",
              "price": 4500,
              "priceCurrency": "ZAR",
              "unitText": "MONTH"
            }
          },
          {
            "@type": "Offer",
            "url": "https://re-charge.co.za/services#websites",
            "itemOffered": {
              "@type": "Service",
              "name": "Websites",
              "description": "Fast, professional websites for small businesses."
            },
            "priceSpecification": {
              "@type": "PriceSpecification",
              "minPrice": 1000,
              "priceCurrency": "ZAR"
            }
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What happens in a process review?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A free 30-minute call. You tell us where your team's time goes; we tell you honestly whether AI is the answer, which process we'd look at first, and what discovery would involve."
          }
        },
        {
          "@type": "Question",
          "name": "Why pay for discovery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Discovery maps the process, measures the baseline and scores every opportunity, and you keep the map whether or not you build with us. It's R7,500 and is credited in full against implementation if you go ahead within 60 days."
          }
        },
        {
          "@type": "Question",
          "name": "Our data is messy. Is that a problem?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It's normal. Data availability is one of the six things we score. If it isn't ready, we tell you what to fix first rather than building something that can't work."
          }
        },
        {
          "@type": "Question",
          "name": "What does Operations cover?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Monitoring, model and API costs up to your plan's allowance, maintenance and security updates, usage monitoring, regular evaluation, support to a defined response time, hours for improvements and small integrations, and a monthly ROI report. From R4,500 a month."
          }
        },
        {
          "@type": "Question",
          "name": "What about our data and privacy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Your data stays in accounts you own, is used only to run your system, and is handled under POPIA. Where a wrong answer could cost you, the system drafts and a person approves."
          }
        }
      ]
    }
  ]
