  <title>Re-Charge — Tell us the problem. We'll build the solution.</title>
  <meta name="description" content="Re-Charge builds websites, dashboards, automation, AI integrations and custom software for South African businesses and individuals. Projects from R1,000, start with a R500 deposit. Tell us the problem and we'll build the solution." />
  <link rel="canonical" href="https://re-charge.co.za/" />
  <meta name="theme-color" content="#0a0d13" />

  <meta property="og:url" content="https://re-charge.co.za/" />
