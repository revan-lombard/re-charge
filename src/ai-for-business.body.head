  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do we need to change the software we use?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Usually not. We connect to what you already run. If a system has no way in, we tell you in discovery and suggest the least disruptive option."
      }
    },
    {
      "@type": "Question",
      "name": "Will it replace our staff?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It replaces the repetitive part of their work, not their judgement. Adoption is one of the six factors we score, because a system nobody uses saves nothing."
      }
    },
    {
      "@type": "Question",
      "name": "What if the AI gets something wrong?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Where a mistake would cost you, the system prepares and a person approves. We test accuracy before go-live and every month in Operations."
      }
    },
    {
      "@type": "Question",
      "name": "Is our data safe?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Your data stays in accounts you own, is used only to run your system, and is handled under POPIA."
      }
    },
    {
      "@type": "Question",
      "name": "What does it cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Discovery is R7,500, credited in full if you go ahead within 60 days. Proof of concept from R18,500, production implementation from R45,000, Operations from R4,500 a month."
      }
    }
  ]
}
  </script>
