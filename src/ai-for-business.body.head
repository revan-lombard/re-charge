      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Do I need to be technical to use AI in my business?", "acceptedAnswer": { "@type": "Answer", "text": "No. We find where AI actually saves you time or wins you customers, build it into a tool you already use (like WhatsApp), and set it up for you. You just use it." } },
        { "@type": "Question", "name": "What does AI cost for a small business?", "acceptedAnswer": { "@type": "Answer", "text": "AI assistants start from R11,500 for the build, with a fixed quote before you pay. The AI usage itself (the running cost from the AI provider) is billed separately and honestly, so you always know what you're paying and it's never hidden in the price." } },
        { "@type": "Question", "name": "Is my business data safe?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We only use your information to power your own tool, we don't share it, and we set things up so the AI answers from your real business facts rather than making things up." } },
        { "@type": "Question", "name": "Can the AI answer customers on WhatsApp?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. A WhatsApp or website assistant trained on your hours, prices, services and FAQs can answer customers day and night, and hand over to you when it's a real lead." } }
      ]
    },
