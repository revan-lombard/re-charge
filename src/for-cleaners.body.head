      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can the quote tool use my real prices?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. You give us your rates per room, frequency and extras; the tool calculates from those, and we can change them any time."
          }
        },
        {
          "@type": "Question",
          "name": "Can clients pay online?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if you want that — deposits or full payment through Yoco. Many cleaning businesses prefer EFT after the job, and that works too."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a logo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. We'll make a clean text logo to start, and you can replace it later."
          }
        }
      ]
    }
