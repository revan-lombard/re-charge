    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Will it give tax or legal advice?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. It answers only from the deadlines, document lists and fees you give us, and anything that needs professional judgement is marked for a person to check before anything is sent."
          }
        },
        {
          "@type": "Question",
          "name": "Is client information safe?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It’s used only to draft your replies, under POPIA. Drafts are written by Claude through Anthropic’s business service, which doesn’t train on your emails, and the transfer outside South Africa is protected the way POPIA requires. We don’t keep the emails you paste, and you can sign our data processing agreement and a mutual NDA first."
          }
        },
        {
          "@type": "Question",
          "name": "We use a practice management system. Does it work with it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, alongside it: your team pastes the email into your private page and copies the reply back. On Microsoft 365 the drafts can wait in your inbox instead."
          }
        },
        {
          "@type": "Question",
          "name": "Who will we deal with?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A small studio: the person on your free call builds it and answers your messages, with no call centre or hand-offs. It’s documented and runs in accounts you own, so any developer can pick it up."
          }
        }
      ]
    }
  ]
