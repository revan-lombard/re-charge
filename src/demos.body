  <!-- Demo widgets (self-contained; no dependencies) -->
  <script>
  (function () {
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* --- Quote calculator --- */
    var qJob = document.getElementById('q-job');
    if (qJob) {
      var addons = ['q-after', 'q-callout', 'q-parts'].map(function (id) { return document.getElementById(id); });
      var totalEl = document.getElementById('q-total');
      var waEl = document.getElementById('q-wa');
      function fmt(n) { return 'R' + n.toLocaleString('en-ZA'); }
      function recalc() {
        var opt = qJob.options[qJob.selectedIndex];
        var base = parseInt(qJob.value, 10);
        var isFrom = opt.getAttribute('data-min') === '0';
        var total = base;
        var extras = [];
        addons.forEach(function (a) { if (a.checked) { total += parseInt(a.value, 10); extras.push(a.parentNode.textContent.trim()); } });
        totalEl.textContent = (isFrom ? 'from ' : '') + fmt(total);
        lastMsg = 'Hi Mike\'s Plumbing, I\'d like a quote.\nJob: ' + opt.text +
          (extras.length ? '\nExtras: ' + extras.join(', ') : '') +
          '\nEstimated total: ' + (isFrom ? 'from ' : '') + fmt(total);
      }
      var lastMsg = '';
      qJob.addEventListener('change', recalc);
      addons.forEach(function (a) { a.addEventListener('change', recalc); });
      waEl.addEventListener('click', function () {
        var done = function () { waEl.textContent = 'Quote copied \u2713 (demo)'; waEl.classList.add('demo__copied'); setTimeout(function () { waEl.textContent = 'Copy this quote for WhatsApp'; waEl.classList.remove('demo__copied'); }, 2200); };
        if (navigator.clipboard && navigator.clipboard.writeText) { navigator.clipboard.writeText(lastMsg).then(done, done); } else { done(); }
      });
      recalc();
    }

    /* --- Sales dashboard --- */
    var seg = document.getElementById('d-seg');
    if (seg) {
      var DATA = {
        month:   { rev: 184500, ord: 132, bars: [22, 31, 28, 44, 39, 52], labs: ['W1','W2','W3','W4','W5','W6'], top: [['Starter Pack', 61200], ['Pro Bundle', 48800], ['Add-on Kit', 32400], ['Support Plan', 24100]] },
        last:    { rev: 156200, ord: 118, bars: [26, 24, 33, 30, 41, 36], labs: ['W1','W2','W3','W4','W5','W6'], top: [['Pro Bundle', 51200], ['Starter Pack', 42600], ['Support Plan', 28900], ['Add-on Kit', 19800]] },
        quarter: { rev: 512800, ord: 388, bars: [148, 156, 184, 132, 168, 205], labs: ['Apr','May','Jun','Jul','Aug','Sep'], top: [['Starter Pack', 172400], ['Pro Bundle', 151900], ['Support Plan', 96700], ['Add-on Kit', 71300]] }
      };
      var revEl = document.getElementById('d-rev'), ordEl = document.getElementById('d-ord'), avgEl = document.getElementById('d-avg');
      var chart = document.getElementById('d-chart'), topEl = document.getElementById('d-top');
      function money(n) { return 'R' + n.toLocaleString('en-ZA'); }
      function render(p) {
        var d = DATA[p], max = Math.max.apply(null, d.bars);
        revEl.textContent = money(d.rev);
        ordEl.textContent = d.ord;
        avgEl.textContent = money(Math.round(d.rev / d.ord));
        chart.innerHTML = d.bars.map(function (v, i) {
          return '<div class="col"><div class="bar" style="height:' + (reduce ? Math.round(v / max * 100) : 2) + '%" data-h="' + Math.round(v / max * 100) + '"></div><span class="lab">' + d.labs[i] + '</span></div>';
        }).join('');
        if (!reduce) requestAnimationFrame(function () { chart.querySelectorAll('.bar').forEach(function (b) { b.style.height = b.getAttribute('data-h') + '%'; }); });
        topEl.innerHTML = d.top.map(function (t) { return '<li><span>' + t[0] + '</span><b>' + money(t[1]) + '</b></li>'; }).join('');
      }
      seg.addEventListener('click', function (e) {
        var b = e.target.closest('button'); if (!b) return;
        seg.querySelectorAll('button').forEach(function (x) { x.classList.remove('is-active'); });
        b.classList.add('is-active');
        render(b.getAttribute('data-p'));
      });
      render('month');
    }

    /* --- AI assistant --- */
    var aiForm = document.getElementById('ai-form');
    if (aiForm) {
      var log = document.getElementById('ai-log'), input = document.getElementById('ai-input');
      var KB = [
        { k: ['hour', 'open', 'time', 'when'], a: 'BuildRight works Monday to Friday, 07:00–17:00, and Saturdays 08:00–13:00. Site visits outside these hours can be arranged on request.', src: 'Company Info.pdf' },
        { k: ['guarantee', 'warranty', 'warrant'], a: 'Yes. All BuildRight workmanship carries a 12-month guarantee. Materials are covered by the manufacturer\'s warranty where applicable.', src: 'Terms of Service.docx' },
        { k: ['area', 'cover', 'where', 'located', 'region'], a: 'BuildRight covers Johannesburg East and the greater Ekurhuleni area. Projects further out are considered case by case.', src: 'Company Info.pdf' },
        { k: ['quote', 'price', 'cost', 'estimate'], a: 'Request a quote by sending your project details and a few photos through the contact form. A site assessment is booked within 2 business days and a written quote follows within 5.', src: 'Sales Process.pdf' },
        { k: ['payment', 'deposit', 'pay'], a: 'BuildRight takes a 40% deposit to schedule a project, with the balance split across agreed milestones. EFT and card are accepted.', src: 'Terms of Service.docx' },
        { k: ['service', 'do', 'offer', 'build'], a: 'BuildRight handles residential and small commercial builds: renovations, extensions, paving, boundary walls and general contracting.', src: 'Services.pdf' }
      ];
      function add(role, html, src) {
        var d = document.createElement('div');
        d.className = 'demo__msg demo__msg--' + role;
        d.innerHTML = html + (src ? '<cite>Source: ' + src + '</cite>' : '');
        log.appendChild(d); log.scrollTop = log.scrollHeight;
      }
      function esc(s){return s.replace(/[&<>]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;'}[c];});}
      function answer(q) {
        var ql = q.toLowerCase(), hit = null, best = 0;
        KB.forEach(function (e) { var n = e.k.filter(function (w) { return ql.indexOf(w) > -1; }).length; if (n > best) { best = n; hit = e; } });
        if (hit) setTimeout(function () { add('bot', esc(hit.a), hit.src); }, 350);
        else setTimeout(function () { add('bot', 'I can only answer from BuildRight\'s sample documents in this demo — try asking about hours, areas covered, guarantees, quotes or payment.'); }, 350);
      }
      function ask(q) { q = q.trim(); if (!q) return; add('user', esc(q)); input.value = ''; answer(q); }
      aiForm.addEventListener('submit', function (e) { e.preventDefault(); ask(input.value); });
      document.getElementById('ai-suggest').addEventListener('click', function (e) { var b = e.target.closest('button'); if (b) ask(b.textContent); });
      add('bot', 'Hi! I\'m the BuildRight assistant. Ask me anything about the company and I\'ll answer from our documents.');
    }

    /* --- Booking widget --- */
    var bDays = document.getElementById('b-days');
    if (bDays) {
      var bService = document.getElementById('b-service');
      var bSlots = document.getElementById('b-slots');
      var bSummary = document.getElementById('b-summary');
      var bConfirm = document.getElementById('b-confirm');
      var DAY = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
      var MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      var SLOTS = ['09:00', '09:45', '10:30', '11:15', '12:00', '13:30', '14:15', '15:00', '15:45'];
      var days = [];
      for (var bi = 1; bi <= 4; bi++) { var bd = new Date(); bd.setDate(bd.getDate() + bi); days.push(bd); }
      var pick = { day: 0, slot: null };
      function bMoney(n) { return 'R' + n.toLocaleString('en-ZA'); }
      // deterministic "taken" slots so the grid feels real but stays stable
      function taken(dayIdx, slotIdx) { return ((dayIdx + 1) * (slotIdx + 2)) % 3 === 0; }
      function renderDays() {
        bDays.innerHTML = days.map(function (d, i) {
          return '<button type="button" data-d="' + i + '"' + (i === pick.day ? ' class="is-active"' : '') + '>' + DAY[d.getDay()] + ' ' + d.getDate() + '</button>';
        }).join('');
      }
      function renderSlots() {
        bSlots.innerHTML = SLOTS.map(function (t, si) {
          var isTaken = taken(pick.day, si);
          return '<button type="button" class="demo__slot' + (pick.slot === t ? ' is-active' : '') + '" data-t="' + t + '"' + (isTaken ? ' disabled aria-disabled="true"' : '') + '>' + t + '</button>';
        }).join('');
      }
      function bUpdate() {
        if (pick.slot) {
          var d = days[pick.day], opt = bService.options[bService.selectedIndex];
          bSummary.textContent = opt.getAttribute('data-name') + ' · ' + DAY[d.getDay()] + ' ' + d.getDate() + ' ' + MON[d.getMonth()] + ' · ' + pick.slot + ' · ' + bMoney(parseInt(bService.value, 10));
          bConfirm.disabled = false;
        } else {
          bSummary.textContent = 'Pick a time';
          bConfirm.disabled = true;
        }
      }
      bDays.addEventListener('click', function (e) {
        var b = e.target.closest('button'); if (!b) return;
        pick.day = parseInt(b.getAttribute('data-d'), 10); pick.slot = null;
        renderDays(); renderSlots(); bUpdate();
      });
      bSlots.addEventListener('click', function (e) {
        var b = e.target.closest('button'); if (!b || b.disabled) return;
        pick.slot = b.getAttribute('data-t'); renderSlots(); bUpdate();
      });
      bService.addEventListener('change', bUpdate);
      bConfirm.addEventListener('click', function () {
        bConfirm.textContent = 'Booked ✓ (demo)'; bConfirm.classList.add('demo__copied'); bConfirm.disabled = true;
        setTimeout(function () { bConfirm.textContent = 'Confirm booking'; bConfirm.classList.remove('demo__copied'); bUpdate(); }, 2400);
      });
      renderDays(); renderSlots(); bUpdate();
    }

    /* --- Instant quote / invoice generator --- */
    var invOpts = document.getElementById('inv-opts');
    if (invOpts) {
      var invVisits = document.getElementById('inv-visits');
      var invLines = document.getElementById('inv-lines');
      var invSub = document.getElementById('inv-sub'), invVat = document.getElementById('inv-vat'), invTotal = document.getElementById('inv-total');
      var invDateEl = document.getElementById('inv-date'), invCopy = document.getElementById('inv-copy');
      var IMON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      var now = new Date();
      invDateEl.textContent = now.getDate() + ' ' + IMON[now.getMonth()] + ' ' + now.getFullYear();
      function iMoney(n) { return 'R' + n.toLocaleString('en-ZA'); }
      var lastQuote = '';
      function invBuild() {
        var visits = parseInt(invVisits.value, 10);
        var rows = [], sub = 0;
        invOpts.querySelectorAll('input:checked').forEach(function (b) {
          var amt = parseInt(b.value, 10) * visits;
          sub += amt; rows.push([b.getAttribute('data-name') + ' × ' + visits, amt]);
        });
        var vat = Math.round(sub * 0.15), total = sub + vat;
        invLines.innerHTML = rows.length
          ? rows.map(function (r) { return '<li><span>' + r[0] + '</span><b>' + iMoney(r[1]) + '</b></li>'; }).join('')
          : '<li><span class="muted">Select a service…</span><b></b></li>';
        invSub.textContent = iMoney(sub); invVat.textContent = iMoney(vat); invTotal.textContent = iMoney(total);
        lastQuote = "Nomsa's Cleaning Services — Quote (" + invDateEl.textContent + ')\n\n' +
          rows.map(function (r) { return r[0] + ': ' + iMoney(r[1]); }).join('\n') +
          '\n\nSubtotal: ' + iMoney(sub) + '\nVAT (15%): ' + iMoney(vat) + '\nTotal / month: ' + iMoney(total);
      }
      invOpts.addEventListener('change', invBuild);
      invVisits.addEventListener('change', invBuild);
      invCopy.addEventListener('click', function () {
        var done = function () { invCopy.textContent = 'Quote copied ✓ (demo)'; invCopy.classList.add('demo__copied'); setTimeout(function () { invCopy.textContent = 'Copy quote'; invCopy.classList.remove('demo__copied'); }, 2200); };
        if (navigator.clipboard && navigator.clipboard.writeText) { navigator.clipboard.writeText(lastQuote).then(done, done); } else { done(); }
      });
      invBuild();
    }
  })();
  </script>

