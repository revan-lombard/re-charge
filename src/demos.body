        <!-- DEMO 3 — AI assistant -->
        <article class="demo" id="ai-assistant">
          <div class="demo__intro reveal">
            <span class="badge">Live · real AI</span>
            <h2>Ask Re-Charge — AI Assistant</h2>
            <p>This one isn't a mock-up: it's a real AI assistant, running on our own site, answering from our own prices and process. It's the same thing we build for clients, pointed at their business instead of ours. From R5,900 to build, then R550/month, plus usage at cost.</p>
            <div class="btn-row">
              <a href="start?type=AI" class="btn btn--primary">Build something similar →</a>
              <a href="free-mockup?demo=ai-assistant&amp;include=An%20assistant%20that%20answers%20customer%20questions%20from%20my%20documents" class="btn btn--free">Mockup first <span class="btn__tag">Free</span></a>
            </div>
          </div>
          <div class="demo__panel reveal">
            <div class="demo__bar"><span class="demo__dot demo__dot--r"></span><span class="demo__dot demo__dot--y"></span><span class="demo__dot demo__dot--g"></span><span class="demo__title">re-charge.co.za</span></div>
            <div class="demo__body">
          <div class="asst" data-assistant>
            <div class="asst__log" aria-live="polite" aria-label="Conversation">
              <div class="asst__msg asst__msg--ai">Hi! I'm Re-Charge's own AI assistant — the same kind we build for clients. Ask me anything about what Re-Charge does, what it costs or how it works.</div>
            </div>
            <div class="asst__chips">
              <button type="button">What does AI cost for a small business?</button>
              <button type="button">How much is a website?</button>
              <button type="button">What can an AI assistant actually do for me?</button>
              <button type="button">How quickly can you build it?</button>
            </div>
            <form class="asst__form">
              <label class="sr-only" for="asstIn2">Ask a question</label>
              <input class="asst__input" id="asstIn2" type="text" maxlength="500" placeholder="Ask about AI, websites or prices…" autocomplete="off" />
              <button type="submit" class="btn btn--primary asst__send">Ask</button>
            </form>
            <p class="asst__note">This is real AI, answering from Re-Charge's own information — not a script. It can be wrong; for anything important, check with us on WhatsApp.</p>
          </div>
            </div>
          </div>
        </article>

