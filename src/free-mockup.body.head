  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://re-charge.co.za/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Free mockup",
          "item": "https://re-charge.co.za/free-mockup"
        }
      ]
    },
    {
      "@type": "Offer",
      "name": "Free website mockup",
      "price": "0",
      "priceCurrency": "ZAR",
      "url": "https://re-charge.co.za/free-mockup",
      "seller": {
        "@id": "https://re-charge.co.za/#business"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is it really free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. No deposit, no card, no contract. We build a one-page preview of your site and send you the link. If you like it, we quote the real build; if not, that's the end of it."
          }
        },
        {
          "@type": "Question",
          "name": "What's the catch?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "There isn't one. It's how we show what we can do before you spend anything — it's easier to decide when you can see your own business on the screen."
          }
        },
        {
          "@type": "Question",
          "name": "What do you need from me?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Your business name, what you do and an email to send the link to. A phone number, your current website, photos or a site you like all help, but none of them are required."
          }
        },
        {
          "@type": "Question",
          "name": "Who can see my mockup?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It lives on an unlisted address that isn't linked from our site and is hidden from Google, so in practice only people you share it with will see it. Want it taken down after you've looked? Just tell us."
          }
        },
        {
          "@type": "Question",
          "name": "What does the real website cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Websites start from R1,000 for a one-page site, R2,000 for a business site and R4,500 for booking or online shop features. You get a fixed quote before anything starts, and you pay the R500 deposit only once you've accepted it — it comes off your total."
          }
        },
        {
          "@type": "Question",
          "name": "How long does the mockup take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually within 2 business days. If we need to ask something, we'll email or WhatsApp you."
          }
        }
      ]
    }
  ]
}
  </script>
