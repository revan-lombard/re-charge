    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Does it talk to callers on the phone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. It doesn’t answer calls. You keep your number: your voicemail greeting and WhatsApp away message point callers to WhatsApp, where the assistant answers straight away. If your phone line can send voicemails by email, those become job cards too."
          }
        },
        {
          "@type": "Question",
          "name": "Does it reply by itself?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only where you choose. We start with drafts and job cards for the office to send. Routine bookings can go out by themselves later, if you switch that on."
          }
        },
        {
          "@type": "Question",
          "name": "What about real emergencies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Anything urgent, a burst pipe, a gas smell, no power, goes to the on-call person immediately, not into a queue."
          }
        },
        {
          "@type": "Question",
          "name": "What if it stops working at night?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Your calls and WhatsApps still come straight to you, exactly as they do today, so nothing is lost. We fix it the next business morning, as part of the monthly plan."
          }
        },
        {
          "@type": "Question",
          "name": "Who will we deal with?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A small studio: the person on your free call builds it and answers your messages, with no call centre or hand-offs. It’s documented and runs in accounts you own, so any developer can pick it up."
          }
        }
      ]
    }
  ]
