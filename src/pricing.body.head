  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Why isn't discovery free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It produces a map of your processes, measured baselines and a scored list of opportunities that you keep. It's credited in full against implementation within 60 days. The process review before it is free."
      }
    },
    {
      "@type": "Question",
      "name": "Can we stop after the proof of concept?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. If the measured result doesn't justify production, we say so, and you've only paid for the proof of concept."
      }
    },
    {
      "@type": "Question",
      "name": "Why is Operations a monthly fee?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Models change, processes change and accuracy drifts if nobody checks it. Operations covers model and API costs up to an allowance, monitoring, security, evaluation, support, improvements and a monthly ROI report."
      }
    },
    {
      "@type": "Question",
      "name": "What if our AI usage goes above the allowance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We warn you at 80%. Anything above it is billed at cost, never marked up."
      }
    },
    {
      "@type": "Question",
      "name": "Do you still build websites?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, from R1,000 with a free preview first, plus Hosting and Care plans, priced separately from the AI work."
      }
    }
  ]
}
  </script>
