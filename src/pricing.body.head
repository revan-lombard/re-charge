  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What do I get at the starting price?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The simplest useful version: a one-page website, one dashboard from one data source, one automation between two tools, one focused AI tool, or a small custom tool. Your proposal shows exactly what's included."
      }
    },
    {
      "@type": "Question",
      "name": "What ongoing costs should I expect?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Hosting from R50 a month, third-party subscriptions and AI usage at cost, and optional support. They are listed in your proposal before you agree to anything."
      }
    },
    {
      "@type": "Question",
      "name": "How do larger AI projects work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In stages you can stop between: a R7,500 discovery (credited if you go ahead), a proof of concept from R18,500, production from R45,000, and support from R4,500 a month with an SLA."
      }
    }
  ]
}
