    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Do you really work with businesses anywhere in South Africa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Everything we do happens online: WhatsApp, email, a free mockup link on your phone, online quotes and card payments. Most clients never need a meeting, and if you'd like one, we do a quick video call."
          }
        },
        {
          "@type": "Question",
          "name": "Do you charge more if I'm far away?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. The prices are the same everywhere: websites from R1,000, hosting from R50 a month, with a fixed quote before you pay anything."
          }
        },
        {
          "@type": "Question",
          "name": "Will my site show up in my own town's searches?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We name the areas you serve on your site and set up your Google Business Profile with the right service area. That's what local search results are built from, wherever you are."
          }
        },
        {
          "@type": "Question",
          "name": "How do I pay?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You accept your fixed quote online and pay the R500 deposit by card (Yoco), or by EFT if you prefer. The balance is due when your site is finished."
          }
        }
      ]
    },
