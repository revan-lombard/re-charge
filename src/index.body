          <div class="hp-actions"><a class="hp-btn hp-btn--light" href="https://calendar.app.google/58FYamh1ahXB4khM9" target="_blank" rel="noopener" data-track="cta-home-trial">Book a free call</a><a class="hp-link hp-link--light" href="inbox-assistant" data-track="cta-home-inbox">How it works &rarr;</a></div>
