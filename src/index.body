            <div class="hp-cmp__before"><picture><source media="(max-width: 600px)" srcset="assets/shots/inbox-before-m.webp?v=5" type="image/webp" width="720" height="906" /><img src="assets/shots/inbox-before.webp?v=5" alt="Before: an inbox with ten unread emails: quote requests, an invoice, a complaint, a newsletter, a long thread and a bank statement, all mixed together." width="1862" height="938" loading="lazy" draggable="false" /></picture><span class="hp-cmp__tag" aria-hidden="true">Before</span></div>
            <div class="hp-cmp__after"><picture><source media="(max-width: 600px)" srcset="assets/shots/inbox-after-m.webp?v=5" type="image/webp" width="720" height="906" /><img src="assets/shots/inbox-after.webp?v=5" alt="After: the same inbox, each email marked urgent, today or routine, and labelled reply drafted, forwarded to accounts, filed, thread summarised or needs a person." width="1862" height="938" loading="lazy" draggable="false" /></picture><span class="hp-cmp__tag" aria-hidden="true">After</span></div>
            <span class="hp-cmp__line" aria-hidden="true"></span>
            <span class="hp-cmp__hint" aria-hidden="true">Drag to sort them</span>
            <span class="hp-cmp__knob" role="slider" tabindex="0" aria-label="Before and after: move left to sort the inbox" aria-valuemin="0" aria-valuemax="100" aria-valuenow="100" aria-valuetext="Before: nothing sorted"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l-5 6 5 6M15 6l5 6-5 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </div>
