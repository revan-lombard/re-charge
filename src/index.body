        <div class="btn-row btn-row--center">
          <a href="start" class="btn btn--light btn--large">Start a Project</a>
          <button type="button" class="btn btn--free btn--large" data-mockup-open>Get a mockup <span class="btn__tag">Free</span></button>
        </div>
        <p class="small muted">Not ready to commit? The mockup costs nothing — no deposit, no obligation. <a class="inline-link" href="demos">See what we build →</a></p>
        <p class="small muted" data-contact-block hidden>Prefer to talk first? <a class="inline-link" href="#" data-contact="whatsapp" hidden>WhatsApp us</a></p>
      </div>
    </section>

