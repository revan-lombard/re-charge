    <!-- ============ HOW IT WORKS ============ -->
    <section class="section" id="process" aria-labelledby="processTitle">
      <div class="container">
        <div class="section__head reveal">
          <span class="eyebrow">How it works</span>
          <h2 id="processTitle">From problem to launch, without the runaround.</h2>
        </div>
        <ol class="steps reveal">
          <li class="step">
            <span class="step__num">1</span>
            <h3>Describe it</h3>
            <p>Tell us what you're trying to accomplish in the Project Builder — in your own words.</p>
          </li>
          <li class="step">
            <span class="step__num">2</span>
            <h3>See a price</h3>
            <p>Get an indicative estimate on the spot, based on what you've described.</p>
          </li>
          <li class="step">
            <span class="step__num">3</span>
            <h3>Pay R500</h3>
            <p>A R500 deposit submits your project for review. It's credited toward your final price.</p>
          </li>
          <li class="step">
            <span class="step__num">4</span>
            <h3>We confirm</h3>
            <p>We review your requirements and confirm the final scope, fixed price and delivery time.</p>
          </li>
          <li class="step">
            <span class="step__num">5</span>
            <h3>Build &amp; launch</h3>
            <p>You approve, we build, you review, the balance is paid and your solution goes live.</p>
          </li>
        </ol>
        <div class="section__foot btn-row reveal">
          <a href="start.html" class="btn btn--primary">Start a Project</a>
          <a href="pricing.html" class="btn btn--ghost">See pricing &amp; the deposit</a>
        </div>
      </div>
    </section>

