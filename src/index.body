
  <main id="main">

    <!-- ============ HERO: AI-first ============ -->
    <section class="hero ai-hero" aria-labelledby="heroTitle">
      <div class="container hero__inner ai-hero__grid">
        <div class="ai-hero__top">
          <span class="eyebrow">AI for small businesses &middot; South Africa</span>
          <h1 id="heroTitle">Every customer answered. <em>Even at midnight.</em></h1>
        </div>
        <div class="hero__copy">
          <p class="lead">We build AI assistants that reply on WhatsApp and your website in seconds &mdash; with your real prices and hours &mdash; take the booking, and hand it to you. The developer you&rsquo;d hire in-house, without the salary. <strong>From R5,900.</strong></p>
          <div class="btn-row hero__cta">
            <a href="ai-for-business#try" class="btn btn--primary btn--large">Try a live assistant</a>
            <a href="#websites" class="btn btn--ghost btn--large">Just need a website?</a>
          </div>
          <ul class="hero__trust">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg> A reply within 1 hour</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg> Fixed quote before you pay</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg> One person, start to finish</li>
          </ul>
        </div>
        <div class="hero__visual ai-hero__visual">
          <figure class="flow-film flow-film--hero reveal">
            <video class="is-hero" data-autoplay muted loop playsinline preload="none" poster="assets/video/ai-poster-hero.jpg" width="792" height="990" aria-label="A 24-second film: at 11:47pm a customer asks a salon whether it is open on Sunday and what a wash and cut costs. The AI assistant answers in seconds with the real hours and price, takes the booking, and the owner wakes up to it at 7am.">
              <source src="assets/video/ai-hero.mp4" type="video/mp4" />
            </video>
          </figure>
        </div>
