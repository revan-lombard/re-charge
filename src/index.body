    <!-- Slide 6: why us -->
    <section id="why" class="hp-slide hp-who hp-who--deck" data-anim aria-labelledby="s6">
      <div class="hp-wrap">
        <div class="hp-who__top">
          <div>
            <p class="hp-num">05</p>
            <p class="hp-label">Why us</p>
            <h2 id="s6">Honest about AI.</h2>
            <p class="hp-who__lead">Often the answer isn&rsquo;t AI at all. We time the work first, and tell you honestly before you spend anything.</p>
