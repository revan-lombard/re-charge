  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "The Re-Charge AI integration method",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Discovery",
      "text": "Map the people, processes, software, data, bottlenecks, repetitive work and decision points, and measure the baseline."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Opportunity mapping",
      "text": "Score every opportunity on time saved, revenue potential, implementation difficulty, data availability, risk and employee adoption."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Proof of concept",
      "text": "Build the smallest useful version on real work."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "ROI validation",
      "text": "Measure before versus after on the same definition, then go, adjust or stop."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "name": "Production",
      "text": "Integrate properly with the client's software, with logging and safe fallbacks."
    },
    {
      "@type": "HowToStep",
      "position": 6,
      "name": "Adoption",
      "text": "Train the people who use it."
    },
    {
      "@type": "HowToStep",
      "position": 7,
      "name": "Optimisation",
      "text": "Monitor, evaluate and improve, with a monthly ROI report."
    }
  ]
}
