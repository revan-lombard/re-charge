  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://re-charge.co.za/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Salons",
          "item": "https://re-charge.co.za/for-salons"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Does it reply by itself?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if you want it to. We start with drafts: the reply is written, you glance at it and press send. Routine answers can go out by themselves later, if you switch that on."
          }
        },
        {
          "@type": "Question",
          "name": "Will it get my prices wrong?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It answers only from the price list and rules you give us. Anything it isn’t sure about is left for you, never guessed."
          }
        },
        {
          "@type": "Question",
          "name": "Do I keep my WhatsApp number?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. It works on your existing WhatsApp Business number, and you can still read and reply on your phone as usual."
          }
        },
        {
          "@type": "Question",
          "name": "Do I still need a website?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not to start. If you want one, a salon site with prices, gallery and booking is an add-on from R12,500."
          }
        },
        {
          "@type": "Question",
          "name": "Who will we deal with?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A small studio: the person on your free call builds it and answers your messages, with no call centre or hand-offs. It’s documented and runs in accounts you own, so any developer can pick it up."
          }
        }
      ]
    }
  ]
}
