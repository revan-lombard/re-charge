    <!-- PILLAR: GET FOUND. -->
    <section class="pillar" id="get-found" aria-labelledby="getFoundTitle">
      <div class="container container--narrow center reveal">
        <span class="eyebrow">Start here if you're not online yet</span>
        <h2 id="getFoundTitle">Get found.</h2>
        <p class="lead">Be there when a customer goes looking for you: a website that works properly on a phone, and a Google profile that puts you on the map. Most clients start here, then grow into working smarter.</p>
