  <main id="main" class="ld-main">
    <p class="ld-loading muted" data-ld-loading>Loading the example…</p>
    <p class="tr__msg tr__msg--bad ld-loading" data-ld-error hidden role="alert"></p>
    <div class="ld container" data-ld hidden>
      <nav class="ld-tabs" data-ld-sample hidden aria-label="Examples"><div class="ld-tabs__row" data-ld-kinds></div></nav>
      <header class="ld-top">
        <div class="ld-top__t">
          <span class="ld-eyebrow"><span class="ld-icon" data-ld-icon></span><span class="eyebrow" data-ld-eyebrow>Live example</span></span>
          <h1 class="ld-h1" data-ld-title></h1>
          <p class="ld-lead" data-ld-lead></p>
        </div>
      </header>

      <div class="ld-bar">
        <button type="button" class="btn btn--primary ld-run" data-ld-run>Run AI</button>
        <label class="ld-switch" data-ld-auto hidden><input type="checkbox" data-ld-auto-input /><span class="ld-switch__ui" aria-hidden="true"></span><span class="ld-switch__txt"><b data-ld-auto-label></b><small data-ld-auto-note></small></span></label>
        <button type="button" class="btn btn--ghost btn--small ld-sortbtn" data-ld-sort hidden aria-pressed="false">Urgent first</button>
      </div>

      <div class="ld-grid">
        <section class="ld-box" aria-label="The work that came in">
          <div class="ld-box__bar"><b data-ld-inbox>Inbox</b><span class="ld-basis" data-ld-basis></span><span class="ld-prog" aria-hidden="true"><i data-ld-prog></i></span></div>
          <nav class="ld-rail" data-ld-rail hidden aria-label="Folders"></nav>
          <ol class="ld-rows" data-ld-rows></ol>
          <div class="ld-detail" data-ld-detail hidden role="dialog" aria-modal="false" aria-label="One item in full">
            <div class="ld-detail__bar"><button type="button" class="btn btn--ghost btn--small" data-ld-close>&larr; Back to the list</button><span class="ld-detail__nav"><button type="button" class="ld-step" data-ld-step="-1" aria-label="Previous item">&lsaquo;</button><span data-ld-pos class="muted small"></span><button type="button" class="ld-step" data-ld-step="1" aria-label="Next item">&rsaquo;</button></span></div>
            <div class="ld-detail__body" data-ld-detail-body></div>
          </div>
        </section>
        <div class="ld-kpis" data-ld-kpis aria-live="polite"></div>
        <div class="ld-time" data-ld-time></div>
        <div class="ld-cta">
          <p><b data-ld-cta-head>Want this on your real work?</b> <span>A free 30-minute call: we look at how it comes in today and tell you honestly whether it&rsquo;s worth it.</span></p>
          <div class="ld-cta__btns"><a class="btn btn--primary btn--small" href="https://calendar.app.google/58FYamh1ahXB4khM9" target="_blank" rel="noopener" data-track="cta-live-demo-book">Book a free call</a><a class="btn btn--ghost btn--small" href="inbox-assistant" data-track="cta-live-demo-inbox">Inbox Assistant</a></div>
        </div>
      </div>
    </div>
  </main>
