# Secrets for the Edge Functions. Set them with:
#   supabase secrets set --env-file supabase/.env
# NEVER commit real values. SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are
# provided automatically by the Supabase runtime — do not set them here.

# Where the site lives (used for Yoco success/cancel redirects)
SITE_URL=https://re-charge.co.za
# Tighten CORS to your domain in production (or leave * while testing)
ALLOW_ORIGIN=https://re-charge.co.za

# Email notifications for new projects (optional — uses Resend). Leave blank to skip.
RESEND_API_KEY=
NOTIFY_EMAIL=enquiry.re.charge@gmail.com
NOTIFY_FROM=Re-Charge <onboarding@resend.dev>

# Optional: Resend delivery events for emails sent from the admin panel
# (Resend → Webhooks → signing secret). Leave blank to skip.
RESEND_WEBHOOK_SECRET=

# Admin "Sites": publish previews to the GitHub Pages repo (previews/<slug>/).
# Fine-grained personal access token with Contents: Read and write on this repo only.
GITHUB_TOKEN=
GITHUB_REPO=revan-lombard/re-charge
GITHUB_BRANCH=main

# Automatic mockup builder (scheduled Claude session) ↔ build-queue function.
# Any long random string; set the SAME value as BUILD_SECRET in the Claude
# cloud environment's variables. e.g. openssl rand -hex 32
BUILD_SECRET=

# Yoco (Sell online → API keys / Webhooks)
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=

# --- Phase 2 (GA4 + Search Console), not used yet ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=https://aqwdncyihcbktbbuvvzd.supabase.co/functions/v1/google-oauth-callback
# 32-byte key (base64) to encrypt stored refresh tokens at rest
TOKEN_ENCRYPTION_KEY=
# Shared secret guarding the scheduled analytics-sync function
SYNC_SECRET=
# Shared secret guarding the scheduled monthly-report function
REPORT_SECRET=
# From address for the monthly client report (falls back to NOTIFY_FROM). Use a
# verified Resend domain in production, e.g. Re-Charge <reports@re-charge.co.za>
REPORT_FROM=
